#!/usr/bin/env bash
# Conventional Commits check
msg_file="$1"
first_line=$(head -n1 "$msg_file")

# Skip merge/revert/fixup commits
if [[ "$first_line" =~ ^(Merge|Revert|fixup!|squash!) ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,100}$'
if ! [[ "$first_line" =~ $pattern ]]; then
  echo "✖ Commit message does not follow the Conventional Commits format:"
  echo "    $first_line"
  echo ""
  echo "  Format:  <type>(<scope>): <description>"
  echo "  Example: feat(parking): add nearby parking search"
  echo "  Details: CONTRIBUTING.md"
  exit 1
fi
